{
  "name": "appteere",
  "version": "2.0.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:next": "next build && next export",
  "electron": "concurrently \"next start\" \"wait-on http://localhost:3000 && electron .\"",
    "build:web": "next build && next export",
    "build:electron": "electron-builder",
    "start:electron": "electron .",
    "build:all": "next build && electron-builder"
  },
  "build": {
    "appId": "com.appteere.application",
    "productName": "AppTeere",
    "files": [
      "electron/**",
      "public/**",
      ".next/**",
      "node_modules/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@headlessui/react": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.0.9",
    "apexcharts": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.5.2",
    "flatpickr": "^4.6.13",
    "install": "^0.13.0",
    "lucide-react": "^0.479.0",
    "next": "15.1.3",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-flatpickr": "^3.10.13",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.0.5",
    "swiper": "^11.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-flatpickr": "^3.8.11",
    "@types/react-transition-group": "^4.4.12",
    "concurrently": "^9.1.2",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  }
}